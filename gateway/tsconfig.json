{
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "build",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../shared/*"]
    },

    "target": "es2016",
    "module": "commonjs",
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "../shared/**/*.ts"]
}

